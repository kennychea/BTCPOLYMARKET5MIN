# --- Paper Trading (set to false for live trading) ---
PAPER_MODE=true

# === Chainlink ===
CHAINLINK_WS_URL=wss://ws.chain.link/btc-usd

# === Vatic Trading API ===
VATIC_API_URL=https://api.vatic.trading
VATIC_API_KEY=

# === Polymarket Gamma API ===
GAMMA_API_URL=https://gamma-api.polymarket.com

# === Polymarket CLOB API ===
CLOB_API_URL=https://clob.polymarket.com
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# === Wallet (Polymarket) ===
PRIVATE_KEY=0x...
PUBLIC_KEY=0x...
API_KEY=
SECRET=
PASSPHRASE=

# === Hyperliquid ===
HYPER_LIQUID_KEY=0x...

# === Risk Parameters ===
MAX_POSITION_USDC=100
MAX_DAILY_LOSS_USDC=50
KILL_SWITCH_DRAWDOWN_PCT=15

# --- Market Making Strategy ---
# STRATEGY=mm              # "stink" (default, directional) or "mm" (market making)
# MM_BASE_SPREAD=0.04      # Base spread in dollars (4 cents)
# MM_ORDER_SIZE=10          # Shares per side per quote
# MM_MAX_INVENTORY=50       # Max net position
# MM_MAX_CVD_SKEW=0.02      # Max CVD price shift
# MM_REFRESH_INTERVAL=10    # Quote refresh interval (seconds)
# MM_NEUTRAL_ONLY=false     # Experimental gate (2026-04-10 diagnostic): skip quoting on non-NEUTRAL CVD signals
